# GEMINI_API_KEY: Required for CareReach Health Assistant (Gemini 3.8 Flash)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="http://localhost:3000"

# Optional Cloud Database & Security Configuration for Production
MONGO_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/carereach?retryWrites=true&w=majority"
JWT_SECRET="carereach-production-jwt-secret-key-replace-in-prod"
SOCKET_URL="http://localhost:3000"
UPLOAD_STORAGE_URL="https://storage.googleapis.com/carereach-vault"
MAPS_API_KEY=""
